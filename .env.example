# ===== دليل جنزور — متغيرات البيئة =====
# انسخ الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى المستودع.

# قاعدة البيانات (Postgres/Neon). لو فاضي: الموقع يعمل في وضع المعاينة بدون حفظ.
DATABASE_URL=

# رابط الموقع الرسمي — يُستخدم في بطاقات المشاركة وروابط الواتساب.
NEXT_PUBLIC_SITE_URL=https://daleel-ganzour.vercel.app

# بيانات دخول لوحة الإدارة.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== إشعارات الويب (Web Push) =====
# اختياري: لو تركتهم فاضيين، الموقع بيولّد مفاتيح تلقائيًا أول مرة ويحفظها في قاعدة البيانات
# (directory_settings / vapid_keys) — والمفتاح الخاص يبقى على الخادم فقط.
# لو عايز تتحكم في المفاتيح بنفسك: npx web-push generate-vapid-keys
# المفتاح العام يُقرأ في المتصفح (لازم يبدأ بـ NEXT_PUBLIC_) والخاص يبقى على الخادم فقط.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# مرسل الإشعار (بريد أو رابط):
VAPID_SUBJECT=mailto:admin@daleel-ganzour.vercel.app
